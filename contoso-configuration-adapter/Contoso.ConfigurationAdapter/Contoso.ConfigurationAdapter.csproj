<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<LangVersion>latest</LangVersion>
		<AssemblyName>Contoso.ConfigurationAdapter</AssemblyName>
		<RootNamespace>Contoso.ConfigurationAdapter</RootNamespace>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<Version>1.0.0-preview01</Version>
		<Company>Contoso</Company>
		<Authors>Contoso</Authors>
		<Description>Contoso ConfigurationAdapter — stub adapter EXE for dev/standalone deployments. Resolves configuration values from a local INI file.</Description>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="JOSYN.Foundation.JIP"                          Version="1.0.0-preview01"/>
		<PackageReference Include="JOSYN.Backend.ConfigurationAdapter.Contract"   Version="1.0.0-preview01"/>
	</ItemGroup>
	<ItemGroup>
		<None Include="..\nuget.config" Visible="false"/>
	</ItemGroup>
	<ItemGroup>
		<Content Include="contoso.config.ini">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
</Project>
