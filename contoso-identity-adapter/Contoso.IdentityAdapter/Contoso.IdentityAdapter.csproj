<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<LangVersion>latest</LangVersion>
		<AssemblyName>Contoso.IdentityAdapter</AssemblyName>
		<RootNamespace>Contoso.IdentityAdapter</RootNamespace>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<Version>1.0.0-preview01</Version>
		<Company>Contoso</Company>
		<Authors>Contoso</Authors>
		<Description>Contoso IdentityAdapter — stub adapter EXE for dev/standalone deployments. Resolves credentials from a local INI file (ADR-017B-03).</Description>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="JOSYN.Foundation.JIP"                    Version="1.0.0-preview01"/>
		<PackageReference Include="JOSYN.Adapter.IdentityAdapter.Contract"  Version="1.0.0-preview01"/>
	</ItemGroup>
	<ItemGroup>
		<None Include="..\Directory.Build.props" Visible="false"/>
		<None Include="..\nuget.config" Visible="false"/>
	</ItemGroup>
	<ItemGroup>
		<Content Include="contoso.credentials.ini">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
</Project>
